# Cash Raja — Caddy reverse proxy (automatic Let's Encrypt HTTPS).
# The backend now serves the admin + landing SPA itself, so Caddy just
# terminates TLS and proxies both domains to it.
#
#   SITE_DOMAIN = cashraja.graduatedcoder.in      → landing (/) + admin (/admin/*) + /api
#   API_DOMAIN  = api.cashraja.graduatedcoder.in  → same backend (Flutter app + postbacks)

{$SITE_DOMAIN} {
	encode gzip zstd
	reverse_proxy backend:3000
}

{$API_DOMAIN} {
	encode gzip zstd
	reverse_proxy backend:3000
}
