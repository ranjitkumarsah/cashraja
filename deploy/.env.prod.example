# Cash Raja — PRODUCTION env for the Hetzner/Docker stack.
# Copy to `.env.prod` and fill in REAL values. NEVER commit `.env.prod`.
# Generate secrets with:  openssl rand -hex 32   (AES_KEY must be exactly 64 hex)

# ── Domains (Caddy auto-provisions HTTPS for these) ──────────────────────────
SITE_DOMAIN=cashraja.graduatedcoder.in
API_DOMAIN=api.cashraja.graduatedcoder.in
# Browser origins allowed to call the API. Same-origin site is proxied by Caddy,
# so this is only needed if the admin/landing is served cross-origin. Safe to set.
CORS_ORIGINS=https://cashraja.graduatedcoder.in

# ── Database / cache (internal compose network; not exposed to the host) ─────
POSTGRES_DB=cashraja
POSTGRES_USER=cashraja
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Secrets — MUST NOT be dev defaults (backend refuses to boot otherwise) ───
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ADMIN_SECRET=CHANGE_ME_openssl_rand_hex_32
AES_KEY=CHANGE_ME_exactly_64_hex_chars_openssl_rand_hex_32

# ── Firebase (real Google Sign-In verification + FCM push) ───────────────────
# 'firebase' (not 'mock') is required in production. Paste the service-account
# JSON as a single line, or leave empty to use Application Default Credentials.
FIREBASE_VERIFIER=firebase
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_DRIVER=firebase

# ── Earn networks — must NOT include 'mock' in production ────────────────────
# Start with none live (manual offers + AdMob only) until offerwall creds land.
OFFERWALL_NETWORKS=
AD_NETWORKS=

# ── Ops ──────────────────────────────────────────────────────────────────────
# Slack-compatible webhook for reconciliation/fraud-spike alerts (empty = console).
ALERT_WEBHOOK_URL=
# Daily 19:00 IST streak-reminder push.
STREAK_REMINDER_ENABLED=true
