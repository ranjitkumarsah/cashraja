# Normalize line endings in the repo (stored as LF), native on checkout — except
# files that MUST stay LF or they break inside Linux containers (a CRLF in a
# shebang = "no such file or directory").
* text=auto

*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
Caddyfile       text eol=lf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
